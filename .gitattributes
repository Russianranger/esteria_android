# Source text keeps stable line endings; binary detection remains enabled.
* text=auto eol=lf
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Explicit case-insensitive extension patterns protect imported/runtime artifacts if
# they are intentionally tracked later. Proprietary game data is not committed.
*.[mM][pP][qQ] binary
*.[bB][iI][nN] binary
*.[dD][bB][cC] binary
*.[dD][bB][cC][1-9]-* binary
*.[mM]2 binary
*.[sS][kK][iI][nN] binary
*.[bB][lL][pP] binary
*.[wW][mM][oO] binary
*.[vV][mM][oO] binary
