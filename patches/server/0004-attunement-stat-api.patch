+// Compatibility with the removed Unit::ApplyStatBuffMod: that API only changed
+// POSSTAT/NEGSTAT display fields. UpdateStatBuffMod(stat) recomputes those fields
+// from equipment/auras and is not an amount/apply replacement. Keep this adapter
+// explicit rather than silently introducing a new permanent combat-stat source.
+static void ApplyAttunementStatDisplay(Player* player, Stats stat, float amount, bool apply)
+{
+    uint16 const field = static_cast<uint16>((amount > 0.0f ? UNIT_FIELD_POSSTAT0 : UNIT_FIELD_NEGSTAT0) + static_cast<uint16>(stat));
+    player->ApplyModSignedFloatValue(field, amount, apply);
+}
