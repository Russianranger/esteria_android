+/* Android's app policy permits anonymous executable memory but rejects
+ * granting execute permission after a private file mapping has been modified.
+ * This explicitly selected PE-only copy path keeps the original anonymous
+ * image reservation. Desktop/default and shared-section mappings are unchanged.
+ * Like the surrounding Wine code, these additions are LGPL-2.1-or-later.
+ */
+static NTSTATUS read_private_pe_file( void *buffer, size_t size, int fd, off_t offset,
+                                     off_t file_size, size_t max_zero_tail )
+{
+    size_t available, done = 0;
+    ssize_t count;
+
+    if (offset < 0 || file_size < 0 || offset > file_size) return STATUS_INVALID_IMAGE_FORMAT;
+    available = size;
+    if ((ULONGLONG)available > (ULONGLONG)(file_size - offset)) available = file_size - offset;
+    if (size - available > max_zero_tail || (size && !available)) return STATUS_INVALID_IMAGE_FORMAT;
+    while (done < available)
+    {
+        size_t chunk = min( available - done, 1024 * 1024 );
+        count = pread( fd, (char *)buffer + done, chunk, offset + done );
+        if (count < 0 && errno == EINTR) continue;
+        /* EOF earlier than the captured fstat size means the input changed. */
+        if (count <= 0) return STATUS_INVALID_IMAGE_FORMAT;
+        done += count;
+    }
+    if (available < size) memset( (char *)buffer + available, 0, size - available );
+    return STATUS_SUCCESS;
+}
+
+/* Reject overlapping/oversized sections before making any shared mappings.
+ * Otherwise a later private copy could modify a prior shared-file mapping.
+ * The opt-in profile deliberately bounds the number of sections to 256.
+ */
+static NTSTATUS validate_private_pe_sections( const IMAGE_SECTION_HEADER *sections, unsigned int count,
+                                             SIZE_T header_size, SIZE_T total_size, SIZE_T align_mask )
+{
+    unsigned int i, j;
+    SIZE_T starts[256], ends[256];
+
+    if (count > 256 || header_size > total_size || align_mask == (SIZE_T)-1 ||
+        (align_mask & (align_mask + 1))) return STATUS_INVALID_IMAGE_FORMAT;
+    for (i = 0; i < count; i++)
+    {
+        SIZE_T size = sections[i].Misc.VirtualSize ? sections[i].Misc.VirtualSize : sections[i].SizeOfRawData;
+        SIZE_T rounded = ROUND_SIZE( 0, size, align_mask );
+        starts[i] = sections[i].VirtualAddress;
+        if (rounded < size || starts[i] > total_size || rounded > total_size - starts[i])
+            return STATUS_INVALID_IMAGE_FORMAT;
+        ends[i] = starts[i] + rounded;
+        if (!rounded) continue;
+        if (starts[i] < header_size || (starts[i] & align_mask)) return STATUS_INVALID_IMAGE_FORMAT;
+        for (j = 0; j < i; j++)
+            if (ends[j] > starts[j] && starts[i] < ends[j] && starts[j] < ends[i])
+                return STATUS_INVALID_IMAGE_FORMAT;
+    }
+    return STATUS_SUCCESS;
+}
