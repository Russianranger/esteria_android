  "sourceDiscriminators": {
    "sourceUrl": "https://github.com/bylaws/wine/tree/a6844d10622fc1a973ec1f22fc4f78a0fcd6cb29",
    "arm64Registration": "loader/wine.inf.in [DefaultInstall.ntarm64]/[RegisterDllsSection] includes mscoree. dlls/setupapi/install.c do_register_dll calls DllRegisterServer synchronously.",
    "mono": "dlls/mscoree/mscoree_main.c install_wine_mono, invoke_appwiz and DllRegisterServer check WoW64 and existing local Mono, then may execute control.exe appwiz.cpl install_mono and wait indefinitely. dlls/mscoree/metahost.c get_mono_path searches local Windows/Unix roots and registry.",
    "offline": "dlls/appwiz.cpl/addons.c checks available MSI files and opens a dialog when absent. WM_INITDIALOG displays it. ID_DWL_INSTALL starts the download via URL moniker. Opening the dialog does not require network.",
    "gecko": "Native mshtml.dll DllRegisterServer registers resources and classes. dlls/mshtml/nsembed.c excludes native AArch64 Gecko loading, confirmed by the exact message in the selected PE. The independently invokable appwiz.cpl supports an installer UI on AArch64.",
    "menuAndMount": "loader/wine.inf.in starts winemenubuilder through RunServices, asynchronously. shell32/shelllink.c also launches the menu builder detached without waiting. MountMgr is added in PreInstall.Services. mountmgr.sys/mountmgr.c starts its run-loop on a separate thread. Both controls reached DefaultInstall.",
    "priorPrefix": "programs/wineboot/wineboot.c:update_timestamp runs before PreInstall and DefaultInstall. A matching .update-timestamp in a previously interrupted prefix by itself does not certify that setup completed."
  },
