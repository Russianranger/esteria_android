  "sourceMechanism": {
    "wineRevision": "a6844d10622fc1a973ec1f22fc4f78a0fcd6cb29",
    "wine": "server/request.c creates /tmp/.wine-UID/server-DEV-INO, then chdir and bind(\"socket\").",
    "proot": "src/syscall/socket.c derives a host path for a guest AF_UNIX bind. If both the translated name and its temporary replacement are too long, it returns EINVAL. src/path/temp.c builds the replacement inside PROOT_TMP_DIR."
